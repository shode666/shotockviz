.env
.env.production
.env.local
.env.*.local
*.pem
*.key
*.crt
caddy-root.crt

# ===== Python =====
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.python-version

