tests/e2e/playwright-report/
tests/e2e/test-results/

# ===== Database / Data =====
*.sql.gz
*.dump
pgdata/
redisdata/
backup*.sql
backend/db/migrations/
# bd:features-2026-09 — user's manually-exported S/R data file (private trading
# data, ~1.4MB); backend/scripts/import_sr_levels.py reads it from here. Dir
# kept via .gitkeep so the expected path exists out of the box.
backend/data/sr_levels/*
!backend/data/sr_levels/.gitkeep

# ===== Docker volumes =====
ollama_data/
postgres_data/
redis_data/

# ===== OS =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

