celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal
celerybeat.pid
*.pid

# ===== Node.js / Frontend =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
package-lock.json

# ===== Vite / Build Output =====
frontend/dist/
frontend/.vite/
frontend/build/
frontend/.output/
.nitro/
.tanstack/

# ===== Testing =====
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
frontend/playwright-report/
