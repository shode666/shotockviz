{
	email {$CADDY_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# bd:shotockviz-30l — legacy XSS auditor disabled ("0"), per OWASP:
		# the auditor itself had vulns; "1; mode=block" is deprecated.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		# bd:shotockviz-30l — CSP hardening, verified against the built
		# .output bundle (see bd notes):
		#   - 'unsafe-eval' REMOVED: 0 eval()/new Function() in built client
		#     chunks.
		#   - 'unsafe-inline' in script-src KEPT: React streaming SSR +
		#     TanStack Start inject inline hydration <script>s; a nonce needs
		#     app-level router.options.ssr.nonce coordinated per-request,
		#     which a static Caddy header cannot do. Accepted for a
		#     single-user app; revisit only if untrusted HTML is ever rendered.
		#   - apis.google.com REMOVED: no reference in frontend/src; Google
		#     Identity Services officially needs only accounts.google.com
		#     (script-src /gsi/client, frame-src + connect-src /gsi/).
		#   - bare "ws:" REMOVED from connect-src: prod is TLS-only.
		#   - added base-uri/object-src/form-action/frame-ancestors +
		#     worker-src parity with dev.
		# ⚠️ Enforcement on the deployed site is only provable after deploy:
		# check Google sign-in + charts + WS with DevTools console open.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' wss: https://accounts.google.com; frame-src https://accounts.google.com; worker-src 'self' blob:"
		-Server
	}

	encode gzip

	# WebSocket — longer read/write timeout for persistent connections
	@ws path /api/ws/*
	reverse_proxy @ws backend:8000 {
		transport http {
			read_timeout 1h
			write_timeout 1h
			dial_timeout 5s
		}
	}

	# REST API — explicit timeouts for long-running Thai stock history requests (up to 30s)
	reverse_proxy /api/* backend:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 35s
			write_timeout 35s
			dial_timeout 5s
		}
	}

	# Frontend — TanStack Start / Nitro SSR server (port 3000)
	reverse_proxy frontend:3000 {
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}
}
