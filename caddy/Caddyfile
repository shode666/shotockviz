{
	email {$CADDY_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ws: wss:"
		-Server
	}

	encode gzip

	# WebSocket — longer read/write timeout for persistent connections
	@ws path /api/ws/*
	reverse_proxy @ws backend:8000 {
		header_up Connection {>Connection}
		header_up Upgrade {>Upgrade}
		transport http {
			read_timeout 1h
			write_timeout 1h
			dial_timeout 5s
		}
	}

	# REST API — explicit timeouts for long-running Thai stock history requests (up to 30s)
	reverse_proxy /api/* backend:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 35s
			write_timeout 35s
			dial_timeout 5s
		}
	}

	# Frontend — TanStack Start / Nitro SSR server (port 3000)
	reverse_proxy frontend:3000 {
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}
}
