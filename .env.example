# ============================================================
# StockViz — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://stockviz:password@db:5432/stockviz_db
POSTGRES_USER=stockviz
POSTGRES_PASSWORD=password
POSTGRES_DB=stockviz_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- JWT -----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- External APIs -----
FINNHUB_API_KEY=your-free-tier-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ----- App -----
APP_ENV=development
DEBUG=True
WORKERS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# bd:deps-2026-09 iter1 (CHRIS-03) — comma-separated IPs and/or CIDR
# blocks whose X-Forwarded-For header the backend trusts for rate-limit
# client-IP identity (api/middleware/rate_limit.py). Leave EMPTY by
# default — safest option, every request's identity falls back to its raw
# TCP socket peer, which cannot be spoofed by a header. Only set this if
# you need per-real-client rate limiting behind Caddy specifically
# (otherwise every Caddy-forwarded request shares Caddy's own IP as one
# bucket, still correctly enforced, just coarser). To find the right
# value: `docker network inspect <project>_stockviz-net | grep Subnet`
# (Caddy and backend share this Docker bridge network) and use that CIDR
# — e.g. TRUSTED_PROXIES=172.20.0.0/16. Do NOT set this to a public/
# internet-reachable range. `docker-compose.dev.yml` exposes the backend
# directly on the host (8000:8000) alongside Caddy — this setting is what
# stops a caller hitting that port directly from spoofing X-Forwarded-For
# to bypass rate limiting (CHRIS-03 / S-AC-4).
TRUSTED_PROXIES=

# ----- Timezone -----
TZ=Asia/Bangkok

# ----- Caddy (Reverse Proxy / TLS) -----
# Set DOMAIN to your real domain for automatic Let's Encrypt TLS
# Leave as localhost for self-signed cert (development/LAN)
DOMAIN=yourdomain.com
CADDY_EMAIL=your@email.com

# ----- Google OAuth -----
# Get from https://console.cloud.google.com → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ----- Optional: AI/Ollama -----
# OLLAMA_URL=http://ollama:11434
