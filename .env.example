# ============================================================
# StockViz — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://stockviz:password@db:5432/stockviz_db
POSTGRES_USER=stockviz
POSTGRES_PASSWORD=password
POSTGRES_DB=stockviz_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- JWT -----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- External APIs -----
FINNHUB_API_KEY=your-free-tier-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ----- App -----
APP_ENV=development
DEBUG=True
WORKERS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Timezone -----
TZ=Asia/Bangkok

# ----- Caddy (Reverse Proxy / TLS) -----
# Set DOMAIN to your real domain for automatic Let's Encrypt TLS
# Leave as localhost for self-signed cert (development/LAN)
DOMAIN=yourdomain.com
CADDY_EMAIL=your@email.com

# ----- Google OAuth -----
# Get from https://console.cloud.google.com → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ----- Optional: AI/Ollama -----
# OLLAMA_URL=http://ollama:11434
